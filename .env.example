# Copy this file to .env.local (gitignored) and fill in your Supabase project's
# values — Project Settings -> API in the Supabase dashboard.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key. It is safe to ship in the
# frontend bundle: it has no write access on its own — the database's Row
# Level Security policies (supabase/migrations/0001_init.sql) are what
# actually restrict writes to admins. Never put the "service_role" key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
